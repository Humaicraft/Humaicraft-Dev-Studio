{
  "name": "humaicraft-dev-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.34.5"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "build": "vite build",
    "package": "vite build && node scripts/extension-package.ts package",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.node.json",
    "verify:extension": "node scripts/extension-package.ts verify",
    "verify": "tsc -p tsconfig.extension.json && tsc -p tsconfig.node.json && vitest run && vite build && node scripts/extension-package.ts verify"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
